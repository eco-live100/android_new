<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="isShimmerShow"
            type="Boolean" />
        <import type="android.text.TextUtils" />
        <import type="android.view.View" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:background="@color/color_F5F5F5"
        android:layout_height="match_parent">


        <include
            android:id="@+id/toolbarSendMoneyInter"
            layout="@layout/custom_toolbar" />


        <ScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/toolbarSendMoneyInter">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                >

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="@{isShimmerShow? View.GONE:View.VISIBLE,default=gone }"

                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">


                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/sendInternationWalletBal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_10sdp"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:layout_marginEnd="@dimen/_10sdp"
                        android:background="@drawable/bg_visit_shop"
                        android:paddingTop="@dimen/_10sdp"
                        android:paddingBottom="@dimen/_10sdp">

                        <TextView
                            android:id="@+id/sendInternationAmt"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/roboto_bold"
                            android:gravity="center"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_18sdp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/roboto_regular"

                            android:gravity="center"
                            android:text="Account balance"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_12ssp"
                            app:layout_constraintEnd_toEndOf="parent"

                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/sendInternationAmt" />


                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <TextView
                        android:id="@+id/addMoney"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:fontFamily="@font/roboto_bold"
                        android:paddingStart="@dimen/_7sdp"
                        android:paddingTop="@dimen/_5sdp"
                        android:paddingEnd="@dimen/_10sdp"
                        android:paddingBottom="@dimen/_5sdp"
                        android:text="+ Add Money"
                        android:textColor="@color/color_3663F5"
                        android:textSize="@dimen/_10ssp" />

                    <TextView
                        android:layout_width="wrap_content"

                        android:layout_height="wrap_content"

                        android:layout_marginStart="@dimen/_10sdp"
                        android:fontFamily="@font/roboto_bold"

                        android:text="Send Money"
                        android:textColor="@color/color_333333"
                        android:textSize="@dimen/_14ssp" />

                    <TextView
                        android:layout_width="wrap_content"

                        android:layout_height="wrap_content"

                        android:layout_marginStart="@dimen/_10sdp"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:fontFamily="@font/roboto_regular"

                        android:text="If your eco-live balance is lower than the amount you intend to send, consider these options..."
                        android:textColor="@color/color_333333"
                        android:textSize="@dimen/_10ssp" />

                    <TextView
                        android:layout_width="wrap_content"

                        android:layout_height="wrap_content"

                        android:layout_marginStart="@dimen/_10sdp"
                        android:layout_marginTop="@dimen/_15sdp"
                        android:fontFamily="@font/roboto_bold"

                        android:text="Send Money To"
                        android:textColor="@color/color_333333"
                        android:textSize="@dimen/_14ssp" />

                    <TextView
                        android:id="@+id/userName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_10sdp"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:layout_marginEnd="@dimen/_10sdp"
                        android:background="@drawable/bg_search"
                        android:fontFamily="@font/roboto_regular"
                        android:hint="Name"
                        android:padding="@dimen/_10sdp"
                        android:singleLine="true"
                        android:textColorHint="@color/color_9F9F9F"
                        android:textSize="@dimen/_12ssp" />

                    <TextView
                        android:id="@+id/email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_10sdp"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:layout_marginEnd="@dimen/_10sdp"
                        android:background="@drawable/bg_search"
                        android:fontFamily="@font/roboto_regular"
                        android:hint="Email"
                        android:padding="@dimen/_10sdp"
                        android:singleLine="true"
                        android:textColorHint="@color/color_9F9F9F"
                        android:textSize="@dimen/_12ssp" />

                    <TextView
                        android:layout_width="wrap_content"

                        android:layout_height="wrap_content"

                        android:layout_marginStart="@dimen/_10sdp"
                        android:layout_marginTop="@dimen/_5sdp"

                        android:fontFamily="@font/roboto_regular"
                        android:text="(Email address or alias)"
                        android:textColor="@color/color_9F9F9F"
                        android:textSize="@dimen/_10ssp" />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_10sdp"
                        android:layout_marginTop="@dimen/_15sdp"
                        android:fontFamily="@font/roboto_bold"
                        android:text="You Send"

                        android:textColor="@color/color_333333"
                        android:textSize="@dimen/_14ssp" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <EditText
                            android:id="@+id/sendAmount"
                            android:layout_width="@dimen/_150sdp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_10sdp"
                            android:layout_marginTop="@dimen/_10sdp"
                            android:layout_marginEnd="@dimen/_5sdp"
                            android:background="@drawable/bg_search"
                            android:fontFamily="@font/roboto_regular"
                            android:hint="1000"
                            android:inputType="number|numberDecimal"
                            android:maxLength="5"
                            android:padding="@dimen/_7sdp"
                            android:singleLine="true"
                            android:textColorHint="@color/color_9F9F9F"
                            android:textSize="@dimen/_12ssp"

                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />


                    </androidx.constraintlayout.widget.ConstraintLayout>


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_10sdp"
                        android:layout_marginTop="@dimen/_15sdp"
                        android:fontFamily="@font/roboto_regular"
                        android:text="@string/Payment_is_for"
                        android:textColor="@color/color_333333"
                        android:textSize="@dimen/_14ssp" />


                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp">


                        <RadioButton
                            android:id="@+id/radioGoodsNService"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_10sdp"
                            android:layout_marginRight="8dp"
                            android:checked="true"
                            android:fontFamily="@font/roboto_regular"
                            android:gravity="center"
                            android:text="Goods/services"
                            android:textSize="@dimen/_12sdp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <RadioButton
                            android:id="@+id/radioGift"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_50sdp"
                            android:fontFamily="@font/roboto_regular"
                            android:gravity="center"
                            android:text="Gift"
                            android:textSize="@dimen/_12sdp"

                            app:layout_constraintBottom_toBottomOf="@+id/radioGoodsNService"
                            app:layout_constraintStart_toEndOf="@+id/radioGoodsNService"
                            app:layout_constraintTop_toTopOf="@id/radioGoodsNService" />


                        <RadioButton
                            android:id="@+id/radioCashAdvance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_10sdp"
                            android:layout_marginTop="@dimen/_7sdp"
                            android:layout_marginRight="8dp"
                            android:fontFamily="@font/roboto_regular"
                            android:gravity="center"
                            android:text="Cash Advance"
                            android:textSize="@dimen/_12sdp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/radioGoodsNService" />


                        <RadioButton
                            android:id="@+id/radioOther"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/roboto_regular"
                            android:gravity="center"
                            android:text="Other"
                            android:textSize="@dimen/_12sdp"
                            app:layout_constraintBottom_toBottomOf="@+id/radioCashAdvance"
                            app:layout_constraintStart_toStartOf="@+id/radioGift"
                            app:layout_constraintTop_toTopOf="@id/radioCashAdvance" />

                    </androidx.constraintlayout.widget.ConstraintLayout>


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_10sdp"
                        android:layout_marginTop="@dimen/_15sdp"

                        android:fontFamily="@font/roboto_bold"
                        android:text="Optional note"
                        android:textColor="@color/color_333333"
                        android:textSize="@dimen/_14ssp" />

                    <EditText
                        android:id="@+id/noteEdt"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_60sdp"
                        android:layout_marginStart="@dimen/_10sdp"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:layout_marginEnd="@dimen/_10sdp"
                        android:background="@drawable/bg_search"
                        android:fontFamily="@font/roboto_regular"
                        android:gravity="top|start"
                        android:hint="Type Here..."
                        android:maxLength="200"
                        android:padding="@dimen/_7sdp"

                        android:textColorHint="@color/color_9F9F9F"
                        android:textSize="@dimen/_12ssp" />


                    <TextView
                        android:id="@+id/txtCounter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_10sdp"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:fontFamily="@font/roboto_regular"
                        android:maxLength="200"
                        android:text="200/200"
                        android:textColor="@color/color_blue"
                        android:textSize="@dimen/_9ssp" />


                    <TextView
                        android:id="@+id/sendMoneyCountinueBtn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_50sdp"
                        android:layout_marginTop="@dimen/_20sdp"
                        android:layout_marginEnd="@dimen/_50sdp"
                        android:layout_marginBottom="@dimen/_20sdp"
                        android:background="@drawable/bg_blue_round_button"
                        android:fontFamily="@font/roboto_regular"
                        android:gravity="center"
                        android:padding="@dimen/_10sdp"
                        android:text="Continue"
                        android:textAllCaps="true"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_14sdp" />

                </LinearLayout>

                <com.facebook.shimmer.ShimmerFrameLayout
                    android:visibility="@{isShimmerShow? View.VISIBLE:View.GONE,default=visible }"

                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                  <LinearLayout
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:orientation="vertical">
                      <androidx.cardview.widget.CardView
                          android:layout_width="match_parent"
                          android:layout_height="@dimen/_100sdp"
                          app:cardBackgroundColor="@color/grey"
                          app:cardCornerRadius="@dimen/_5sdp"
                          android:alpha="0.6"
                          android:layout_margin="@dimen/_10sdp"/>

                      <androidx.cardview.widget.CardView
                          android:layout_width="match_parent"
                          android:layout_height="@dimen/_100sdp"
                          app:cardBackgroundColor="@color/grey"
                          app:cardCornerRadius="@dimen/_5sdp"
                          android:alpha="0.6"
                          android:layout_marginTop="@dimen/_10sdp"
                          android:layout_margin="@dimen/_10sdp"/>

                      <androidx.cardview.widget.CardView
                          android:layout_width="match_parent"
                          android:layout_height="@dimen/_100sdp"
                          app:cardBackgroundColor="@color/grey"
                          app:cardCornerRadius="@dimen/_5sdp"
                          android:alpha="0.6"
                          android:layout_marginTop="@dimen/_10sdp"
                          android:layout_margin="@dimen/_10sdp"/>
                      <androidx.cardview.widget.CardView
                          android:layout_width="match_parent"
                          android:layout_height="@dimen/_100sdp"
                          app:cardBackgroundColor="@color/grey"
                          app:cardCornerRadius="@dimen/_5sdp"
                          android:alpha="0.6"
                          android:layout_marginTop="@dimen/_10sdp"
                          android:layout_margin="@dimen/_10sdp"/>
                  </LinearLayout>

                </com.facebook.shimmer.ShimmerFrameLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>


        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>